<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>oikos.caddy</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{CADDY}}</string>
		<string>run</string>
		<string>--config</string>
		<string>{{OIKOS}}/ingress/Caddyfile</string>
		<string>--adapter</string>
		<string>caddyfile</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{OIKOS}}</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>{{OIKOS}}/logs/oikos.caddy.log</string>
	<key>StandardErrorPath</key>
	<string>{{OIKOS}}/logs/oikos.caddy.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{HOME}}</string>
		<key>XDG_DATA_HOME</key>
		<string>{{OIKOS}}/.state/data</string>
		<key>XDG_CONFIG_HOME</key>
		<string>{{OIKOS}}/.state/config</string>
	</dict>
</dict>
</plist>
